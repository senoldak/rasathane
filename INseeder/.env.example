# INseeder Environment Configuration Template
# Copy this file to .env and adjust values as needed.

# Database
INSEEDER_DB_PATH=inseeder.db

# SEC EDGAR Ingestion Settings
# Note: SEC Fair Access requires a descriptive User-Agent with contact information.
SEC_USER_AGENT=INseeder Research admin@inseeder.local
POLL_INTERVAL_SEC=30.0

# Alerting Channels
# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rasathane Telegram kanalı (python -m inseeder.kanal)
# Panelin TELEGRAM_CHAT_ID'sinden ayrıdır; kanal yalnız TELEGRAM_HEDEF'e yazar.
# Biçim: @grup:konu_kimliği (forum konusu) ya da @kanal. Boşsa gönderim yapılmaz.
TELEGRAM_HEDEF=
# Hata bildirimlerinin gideceği kişisel sohbet kimliği
TELEGRAM_SAHIP_ID=

# Discord Webhook Configuration
DISCORD_WEBHOOK_URL=

# Broker Adapter Configuration
# Options: paper | alpaca | ibkr
DEFAULT_BROKER=paper

# Alpaca Markets API Credentials
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Interactive Brokers Client Portal Gateway
IBKR_BASE_URL=https://localhost:5000/v1/api
IBKR_ACCOUNT_ID=

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
