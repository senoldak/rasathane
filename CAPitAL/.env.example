# CAPitAL — Environment Configuration Template
# Copy this file to .env and configure local values

# Application Settings
APP_NAME=CAPitAL
ENVIRONMENT=development
DEBUG=true

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./capitolseeder.db

# Quantitative Scoring Weights (Must sum approximately to 1.0)
WEIGHT_CONFLICT=0.35
WEIGHT_CLUSTER=0.25
WEIGHT_WINRATE=0.15
WEIGHT_SIZE=0.15
WEIGHT_ASSET=0.10

# Compliance & Penalties
STOCK_ACT_GRACE_DAYS=45
STATUTORY_FINE_BASE=200.0

# Alert Thresholds
HIGH_ALPHA_THRESHOLD=80.0
HIGH_CONFLICT_THRESHOLD=85.0

# External Webhooks & Alert Dispatchers (Optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
