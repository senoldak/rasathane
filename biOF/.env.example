# biOF Configuration Template

PROJECT_NAME=biOF
VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true

# Database Connection (SQLite WAL default; PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./bioseeder.db
DATABASE_ECHO=false

# Upstream Regulatory & Clinical Data Providers
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_API_KEY=

# Ingestion Rate Limiting & Resilience
COLLECTOR_RATE_LIMIT_HZ=5.0
COLLECTOR_MAX_RETRIES=4
COLLECTOR_BACKOFF_BASE_SEC=1.0
COLLECTOR_TIMEOUT_SEC=15.0

# Security (Required for /seed endpoint when DEBUG=false)
ADMIN_API_KEY=

# CORS Configuration
CORS_ORIGINS=["*"]
